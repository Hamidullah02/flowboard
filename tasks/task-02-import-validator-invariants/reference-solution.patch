+  // A node's size must be positive. A zero-sized node cannot be clicked,
+  // and a negative one is drawn flipped, which puts its ports in the wrong
+  // place and routes every attached edge to the wrong point.
+  if (w <= 0 || h <= 0) {
+    return { ok: false, error: `Node "${id}" has a size that is not positive.` };
+  }
+
+  // Every node the app creates is snapped to the grid, so a document with a
+  // node that is not on the grid could not have come from the app. Reject it
+  // rather than silently repairing it.
+  if (snap(x) !== x || snap(y) !== y) {
+    return { ok: false, error: `Node "${id}" is not on the grid.` };
+  }
+
   return { ok: true, value: { id, kind, x, y, w, h, label } };
